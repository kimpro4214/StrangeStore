    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 7
    characterSequence: "\uC774 \uC0BD\uC73C\uB85C \uB545 \uC5B4\uB518\uAC00\uB97C\n\uD314
      \uC218 \uC788\uC744 \uAC83 \uAC19\uC740\uB370..\uBB50\uC57C \uC120\uBB3C\uC778\uAC00?
      \uBC18\uAC11\uAD70.\uACE0\uB9D9\uAC8C \uBC1B\uACA0\uB124.\uAC11\uC790\uAE30
      \uB3C8\uC744 \uC65C \uC8FC\uB294\uAC74\uAC00? \uB098\uC57C \uACE0\uB9D9\uC9C0\uB9CC..\uC77C\uB2E8
      \uBC1B\uACA0\uB124. \uACE0\uB9D9\uB124.\uC774 \uACE8\uB3D9\uD488\uC740 \uB300\uCCB4...
      \uC5B4\uB514\uC11C \uBC1C\uACAC\uD55C\uAC74\uAC00?\uB0B4\uAC00 \uC0AC\uACA0\uB124.
      \uB300\uC2E0 \uC5F4\uC1E0\uB97C \uCC3E\uB3C4\uB85D \uB9C8\uBC95\uC744 \uC368\uC8FC\uC9C0.\uD718\uD30C\uB78C
      \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uBA74 \uADF8 \uACF3\uC73C\uB85C \uAC00\uC11C
      \uB545\uC744 \uD30C\uBCF4\uAC8C.\uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294
      \uC0DD\uC120\uC774\uC796\uB294\uAC00!!!\uC774 \uC5B4\uCC0C\uD560 \uBC14\uB97C
      \uBAA8\uB974\uACA0\uB124.. \uB300\uC2E0 \uC774 \uC5F4\uC1E0\uB97C \uC8FC\uB3C4\uB85D
      \uD558\uC9C0.\uC774 \uB3CB\uBCF4\uAE30\uB85C\uB9CC \uBCF4\uC774\uB294 \uBB3C\uAC74\uC774
      \uC788\uC744\uAE4C?\uD2B8\uB9AC\uAC70\uB97C \uAFB9 \uB204\uB974\uBA74 \uD2B9\uC815
      \uB545\uC774 \uD30C\uC9C8 \uAC83 \uAC19\uC740\uB370..\uC774\uAC78 \uC65C \uC8FC\uB294
      \uAC74\uAC00..? \uB0B4 \uC774\uB450\uADFC\uC774\uB77C\uB3C4 \uBCF4\uC5EC\uC8FC\uC9C0."
