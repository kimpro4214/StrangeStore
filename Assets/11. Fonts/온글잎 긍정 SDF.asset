    atlasWidth: 512
    atlasHeight: 512
    characterSetSelectionMode: 7
    characterSequence: "\uC81C\uC791\r\n214620 \uD55C\uC9C0\uD6C8\r\n214014 \uAE40\uD604\uADDC\r\n!
      \uACBD\uD638\uC6D0 \uBD80\uB974\uAE30 \uC804\uC5D0!!\uC774 \uD754\uD574 \uBE60\uC9C4
      \uC0AC\uACFC\uB294 \uD544\uC694 \uC5C6\uB2E4\uB124..\uAC00\uC838\uAC00\uC11C
      \uADF8\uB0E5 \uBCF8\uC778\uC774 \uB4DC\uC2DC\uAC8C\uB098.\uD551\uD06C\uC0C9\uC740
      \uC4F0\uB808\uAE30\uD1B5\uC5D0 \uAC14\uB2E4 \uBC84\uB9AC\uAC8C.\uB364\uBCA8\uC778\uAC74
      \uC88B\uC740\uB370..\uC774 \uC0BD\uC73C\uB85C \uB545 \uC5B4\uB518\uAC00\uB97C\r\n\uD314
      \uC218 \uC788\uC744 \uAC83 \uAC19\uC740\uB370..\uBB50\uC57C \uC120\uBB3C\uC778\uAC00?
      \uBC18\uAC11\uAD70.\uACE0\uB9D9\uAC8C \uBC1B\uACA0\uB124.\uAC11\uC790\uAE30
      \uB3C8\uC744 \uC65C \uC8FC\uB294\uAC74\uAC00? \uB9C8\uC74C\uC740 \uACE0\uB9D9\uC9C0\uB9CC
      \uBC1B\uC744 \uC218 \uC5C6\uB124. \uACE0\uB9D9\uB124.\uC774 \uACE8\uB3D9\uD488\uC740
      \uB300\uCCB4... \uC5B4\uB514\uC11C \uBC1C\uACAC\uD55C\uAC74\uAC00?\uB0B4\uAC00
      \uC0AC\uACA0\uB124. \uB300\uC2E0 \uC5F4\uC1E0\uB97C \uCC3E\uB3C4\uB85D \uB9C8\uBC95\uC744
      \uC368\uC8FC\uC9C0.\uD718\uD30C\uB78C \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uBA74
      \uADF8 \uACF3\uC73C\uB85C \uAC00\uC11C \uB545\uC744 \uD30C\uBCF4\uAC8C.\uB0B4\uAC00
      \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uC0DD\uC120\uC774\uC796\uB294\uAC00!!!\uC774
      \uC5B4\uCC0C\uD560 \uBC14\uB97C \uBAA8\uB974\uACA0\uB124.. \uB300\uC2E0 \uC774
      \uC5F4\uC1E0\uB97C \uC8FC\uB3C4\uB85D \uD558\uC9C0.\uC774 \uB3CB\uBCF4\uAE30\uB85C\uB9CC
      \uBCF4\uC774\uB294 \uBB3C\uAC74\uC774 \uC788\uC744\uAE4C?\uD2B8\uB9AC\uAC70\uB97C
      \uAFB9 \uB204\uB974\uBA74 \uD2B9\uC815 \uB545\uC774 \uD30C\uC9C8 \uAC83 \uAC19\uC740\uB370..\uC774\uAC78
      \uC65C \uC8FC\uB294 \uAC74\uAC00..? \uB0B4 \uC774\uB450\uADFC\uC774\uB77C\uB3C4
      \uBCF4\uC5EC\uC8FC\uC9C0.\uC544\uB2C8 \uC5EC\uAE30\uAC00 \uC5B4\uB514\uB77C\uACE0
      \uB4E4\uC5B4\uC624\uB294\uAC00!!\uB2F9\uC7A5 \uB098\uAC00\uAC8C!!\uD50C\uB808\uC774\uD574\uC8FC\uC154\uC11C
      \uAC10\uC0AC\uD569\uB2C8\uB2E4.\r\n2\uD0C4 Security Room\uC744 \uAE30\uB300\uD574\uC8FC\uC138\uC694.\r\n\uB9C8\uC74C\uB9CC
      \uBC1B\uACA0\uB124.\uC774 \uACE8\uB3D9\uD488\uC740 \uB300\uCCB4... \uC5B4\uB514\uC11C
      \uCC3E\uC558\uB098?\uD551\uD06C\uC0C9\uC740 \uC4F0\uB808\uAE30\uD1B5\uC5D0
      \uAC14\uB2E4 \uBC84\uB9AC\uAC8C.\uC54A\uC558\uC5C8\uC788\uC5E4\uC638\uC5E3\uB514\uC788\uC628\uC5F4\uC1E0\uAC00
      \uD30C\uC84C\uB2E4!!"
