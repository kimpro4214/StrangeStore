    - target: {fileID: 3930448733891717095, guid: 27589909ee4ba0140b5b7d252bb31a19,
        type: 3}
      propertyPath: 'reactions.Array.data[3].lines.Array.data[0]'
      value: "\uC774\uAC78 \uC65C \uC8FC\uB294 \uAC74\uAC00..?"
      objectReference: {fileID: 0}
    - target: {fileID: 3930448733891717095, guid: 27589909ee4ba0140b5b7d252bb31a19,
