      propertyPath: 'reactions.Array.data[3].lines.Array.data[1]'
      value: "\uB0B4 \uC774\uB450\uADFC\uC774\uB77C\uB3C4 \uBCF4\uC5EC\uC904\uD14C\uB2C8
