    - target: {fileID: 3930448733891717095, guid: 27589909ee4ba0140b5b7d252bb31a19,
        type: 3}
      propertyPath: 'reactions.Array.data[0].lines.Array.data[0]'
      value: "\uBB50\uC57C \uC120\uBB3C\uC778\uAC00? \uBC18\uAC11\uAD70."
      objectReference: {fileID: 0}
    - target: {fileID: 3930448733891717095, guid: 27589909ee4ba0140b5b7d252bb31a19,
        type: 3}
      propertyPath: 'reactions.Array.data[0].lines.Array.data[1]'
      value: "\uC0AC\uACFC\uB294 \uC369\uC5B4 \uB118\uCE58\uB2C8 \uB2E4\uC2DC \uAC00\uC838\uAC00\uAC8C."
