    - target: {fileID: 3930448733891717095, guid: 27589909ee4ba0140b5b7d252bb31a19,
        type: 3}
      propertyPath: 'reactions.Array.data[1].lines.Array.data[0]'
      value: "\uAC11\uC790\uAE30 \uB3C8\uC744 \uC65C \uC8FC\uB294\uAC74\uAC00?"
      objectReference: {fileID: 0}
    - target: {fileID: 3930448733891717095, guid: 27589909ee4ba0140b5b7d252bb31a19,
        type: 3}
      propertyPath: 'reactions.Array.data[1].lines.Array.data[1]'
      value: "\uB9C8\uC74C\uC740 \uACE0\uB9D9\uC9C0\uB9CC \uBC1B\uC744 \uC218 \uC5C6\uB124."
