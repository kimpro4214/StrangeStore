  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueMerchant
  typer: {fileID: 7198658601352124438}
  autoNextDelay: 2.2
  reactions:
  - type: 0
    lines:
    - "\uC774 \uD754\uD574 \uBE60\uC9C4 \uC0AC\uACFC\uB294 \uD544\uC694 \uC5C6\uB2E4\uB124.."
    - "\uAC00\uC838\uAC00\uC11C \uADF8\uB0E5 \uBCF8\uC778\uC774 \uB4DC\uC2DC\uAC8C\uB098."
  - type: 1
    lines:
    - "\uAC11\uC790\uAE30 \uB3C8\uC744 \uC65C \uC8FC\uB294\uAC74\uAC00?"
    - "\uB9C8\uC74C\uC740 \uACE0\uB9D9\uC9C0\uB9CC \uBC1B\uC744 \uC218 \uC5C6\uB124."
  - type: 2
    lines:
    - "\uC774 \uACE8\uB3D9\uD488\uC740 \uB300\uCCB4... \uC5B4\uB514\uC11C \uBC1C\uACAC\uD55C\uAC74\uAC00?"
    - "\uB0B4\uAC00 \uC0AC\uACA0\uB124. \uB300\uC2E0 \uC5F4\uC1E0\uB97C \uCC3E\uB3C4\uB85D
      \uB9C8\uBC95\uC744 \uC368\uC8FC\uC9C0."
    - "\uD718\uD30C\uB78C \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uBA74 \uADF8 \uACF3\uC73C\uB85C
      \uAC00\uC11C \uB545\uC744 \uD30C\uBCF4\uAC8C."
  - type: 4
    lines:
    - "\uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uC0DD\uC120\uC774\uC796\uB294\uAC00!!!"
    - "\uC774 \uC5B4\uCC0C\uD560 \uBC14\uB97C \uBAA8\uB974\uACA0\uB124.. \uB300\uC2E0
      \uC774 \uC5F4\uC1E0\uB97C \uC8FC\uB3C4\uB85D \uD558\uC9C0."
  - type: 3
    lines:
    - "\uB364\uBCA8\uC778\uAC74 \uC88B\uC740\uB370.."
    - "\uD551\uD06C\uC0C9\uC740 \uC4F0\uB808\uAE30\uD1B5\uC5D0 \uAC14\uB2E4 \uBC84\uB9AC\uAC8C."
  background: {fileID: 7042517519240523186}
